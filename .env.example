# Copy to .env for local development.
# In Netlify/Dokploy, set these in the platform environment UI (do not commit .env).

# Prisma / MySQL
# Local or DigitalOcean (with SSL):
# DATABASE_URL=mysql://USER:PASSWORD@HOST:25060/daily_report?ssl-mode=REQUIRED
#
# Dokploy MySQL (usually no SSL, use the Docker service name as host — not localhost):
# DATABASE_URL=mysql://USER:PASSWORD@mysql:3306/daily_report

DATABASE_URL=

# Legacy MongoDB routes only
mongodbUsername=
mongodbPass=
